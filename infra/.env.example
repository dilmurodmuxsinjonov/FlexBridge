# Copy to infra/.env locally; do not commit real credentials.
# Use a URL-safe POSTGRES_PASSWORD: Compose interpolates it into DATABASE_URL.
POSTGRES_DB=flexbridge
POSTGRES_USER=flexbridge_owner
POSTGRES_PASSWORD=
MINIO_ROOT_USER=flexbridge_minio
MINIO_ROOT_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PAYMENT_WEBHOOK_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
AUTH_HMAC_KEY=
# HTTPS SMS/email gateway implementing POST /otp; no real messages are sent by tests.
AUTH_DELIVERY_URL=
AUTH_DELIVERY_TOKEN=
# Set these to the versions of the policies actually published by your application.
TERMS_POLICY_VERSION=
PRIVACY_POLICY_VERSION=
# Exact deployed HTTPS origin and RP domain (no scheme in RP ID).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# A real HTTPS gateway implementing the contract in backend/README.md is required for refunds.
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_TOKEN=
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
