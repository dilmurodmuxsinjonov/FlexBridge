#!/bin/sh
# User froze main/master; all new work integrates on integration/r1-agent-collaboration.
while read local_ref local_oid remote_ref remote_oid
do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "Push blocked: main/master are frozen by the user. Use integration/r1-agent-collaboration." >&2
      exit 1
      ;;
  esac
done
exit 0
